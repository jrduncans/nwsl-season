# Copy this to config.env locally, or have 1Password Environments manage
# config.env. The actual config.env file is intentionally ignored by Git.
HONEYCOMB_API_KEY=
OTEL_SERVICE_NAME=nwsl-season
# The binary supplies service.version from Go build metadata. Add stable
# deployment identity here; use a distinct value for each running environment.
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=test,service.instance.id=macos-test-shell

# For the EU Honeycomb instance, uncomment the next line.
# HONEYCOMB_API_ENDPOINT=https://api.eu1.honeycomb.io

# Optional: enables native OpenTelemetry HTTP metrics in Honeycomb.
# OTEL_METRICS_EXPORTER=otlp
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

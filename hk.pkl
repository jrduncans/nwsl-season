amends "package://github.com/jdx/hk/releases/download/v2.12.0/hk@2.12.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.12.0/hk@2.12.0#/Builtins.pkl"
// Using a coding agent? See https://hk.jdx.dev/agents

// Top-level steps also form the check, fix and pre-commit hooks.
// E2E, race, telemetry-live-check (Docker) and the benchmark guards run only in CI.
local linters = new Mapping {
    ["trailing_whitespace"] = Builtins.trailing_whitespace
    ["newlines"] = Builtins.newlines
    ["mixed_line_ending"] = Builtins.mixed_line_ending
    ["byte_order_marker"] = Builtins.byte_order_marker
    ["check_merge_conflict"] = Builtins.check_merge_conflict
    ["check_case_conflict"] = Builtins.check_case_conflict
    ["check_symlinks"] = Builtins.check_symlinks
    ["check_executables_have_shebangs"] = Builtins.check_executables_have_shebangs
    ["check_shebang_scripts_are_executable"] = Builtins.check_shebang_scripts_are_executable
    // Generated model-evaluation evidence is the one large file kept on purpose.
    ["check_added_large_files"] = (Builtins.check_added_large_files) {
        exclude = List("docs/model-evaluation-v1.json")
    }
    // Staged mode: a directory scan would read config.env, which may be a 1Password FIFO.
    ["gitleaks"] = (Builtins.gitleaks) { scan = "staged" }
    // Allowed words and vendored exclusions live in _typos.toml.
    ["typos"] = Builtins.typos
    ["go_fix"] = Builtins.go_fix
    ["ruff"] = Builtins.ruff
    ["ruff_format"] = Builtins.ruff_format
    ["jactionlint"] = Builtins.jactionlint
    ["golangci_lint"] = Builtins.golangci_lint
    ["golangci_lint_fmt"] = Builtins.golangci_lint_fmt
    ["gomod_tidy"] = Builtins.gomod_tidy
    ["shellcheck"] = Builtins.shellcheck
    ["shellharden"] = Builtins.shellharden
    ["shfmt"] = Builtins.shfmt
    ["zizmor"] = Builtins.zizmor
    // Raw nwsl.* attribute constructors belong only in the generated package.
    ["telemetry_code"] = new Step {
        glob = List("cmd/**/*.go", "internal/**/*.go")
        exclude = List("**/*_test.go", "internal/telemetry/nwslconv/**")
        check = "make telemetry-check-code"
    }
    // Registry and policy checks, then a diff against the generated docs and Go.
    // The fix regenerates both, after gofmt so the two never write the same files at once.
    ["telemetry_generated"] = new Step {
        glob = List("telemetry/registry/**", "telemetry/policies/**", "telemetry/templates/**", "docs/telemetry/catalog/**", "internal/telemetry/nwslconv/**")
        depends = "golangci_lint_fmt"
        // Weaver warns on every run that the semconv dependency's manifest lacks
        // file_format (still true upstream in v1.45.0). Show output only on failure.
        output_summary = "hide"
        check = "make telemetry-check-generated"
        fix = "make telemetry-generate"
        stage = List("docs/telemetry/catalog/**", "internal/telemetry/nwslconv/**")
    }
}

steps = linters

hooks {
    // Keeps the other top-level steps; this one only makes sense for a commit,
    // so `hk check` and CI (which runs on main) skip it.
    ["pre-commit"] {
        steps {
            ["no_commit_to_branch"] = Builtins.no_commit_to_branch
        }
    }
    ["pre-push"] {
        // The default config.env may be a 1Password-backed FIFO.
        env {
            ["NWSL_CONFIG_FILE"] = "/dev/null"
        }
        steps {
            // No glob: templates, static files and testdata affect tests too, and
            // the Go test cache makes an unchanged tree take under a second.
            ["go_test"] = new Step {
                check = "go test ./..."
            }
            // Reachability-based, so any Go change can expose a vulnerability.
            // Needs the vulnerability database, so it runs here rather than per commit.
            ["go_vuln_check"] = (Builtins.go_vuln_check) {
                glob = List("**/*.go", "go.mod", "go.sum")
            }
        }
    }
}
